+inline Location const* Select(std::vector<Location const*> const& candidates, uint32_t roll)
+{
+    Location const* queued = nullptr;
+    for (auto const* row : candidates)
+        if (row->Queued && (!queued || row->Queued > queued->Queued))
+            queued = row;
+    if (queued)
+        return queued;
+    if (!roll)
+        return nullptr;
+    for (auto const* row : candidates)
+    {
+        if (roll <= row->Weight)
+            return row;
+        roll -= row->Weight;
+    }
+    return nullptr;
+}
 

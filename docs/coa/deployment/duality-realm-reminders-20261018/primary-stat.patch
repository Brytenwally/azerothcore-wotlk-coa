+-- Area 52 uses the legacy advancement sidebar. Free Pick alone is not a
+-- realm discriminator: Season 10 Free Pick must retain Path of Duality.
+function IsArea52PrimaryStatRealm()
+    return GetRealmName() == "Area 52 - Free-Pick"
+end
+
+local primaryStatLastReminder
+local primaryStatDeferredClose = false
+local primaryStatWorldReady = false
+local primaryStatDungeon
+
+function HidePrimaryStatReminder()
+    if not IsArea52PrimaryStatRealm() then return end
+    if ForcedPrimaryStatFrame then
+        -- Cancel a pending fade as well as hiding the frame.
+        UIFrameFadeRemoveFrame(ForcedPrimaryStatFrame)
+        ForcedPrimaryStatFrame:Hide()
+    end
+end
+
+function RequestPrimaryStatReminder(menuClosed)
+    if not IsArea52PrimaryStatRealm() or not primaryStatWorldReady then return false end
+    if not C_Player:IsHero() or C_PrimaryStat:GetActivePrimaryStat() then
+        primaryStatDeferredClose = false
+        return false
+    end
+    if CharacterAdvancement and CharacterAdvancement:IsShown() then return false end
+    if InCombatLockdown() then
+        primaryStatDeferredClose = primaryStatDeferredClose or menuClosed
+        return false
+    end
+    if ForcedPrimaryStatFrame and ForcedPrimaryStatFrame:IsShown() then return false end
+    local now = GetTime()
+    if not menuClosed and primaryStatLastReminder and now - primaryStatLastReminder < 60 then return false end
+    if ShowForcedPrimaryStat(false) then
+        primaryStatLastReminder = now
+        primaryStatDeferredClose = false
+        return true
+    end
+    return false
+end
+
+local function HookPrimaryStatAdvancement()
+    if not CharacterAdvancement or CharacterAdvancement.primaryStatReminderHooked then return end
+    CharacterAdvancement.primaryStatReminderHooked = true
+    CharacterAdvancement:HookScript("OnShow", HidePrimaryStatReminder)
+    CharacterAdvancement:HookScript("OnHide", function() RequestPrimaryStatReminder(true) end)
+    if CharacterAdvancement:IsShown() then HidePrimaryStatReminder() end
+end
+
+local primaryStatReminderEvents = CreateFrame("Frame")
+for _, event in ipairs({"ADDON_LOADED", "PLAYER_ENTERING_WORLD", "PLAYER_LEAVING_WORLD",
+    "ZONE_CHANGED_NEW_AREA", "QUEST_ACCEPTED", "PLAYER_REGEN_ENABLED", "PLAYER_REGEN_DISABLED"}) do
+    primaryStatReminderEvents:RegisterEvent(event)
+end
+primaryStatReminderEvents:SetScript("OnEvent", function(self, event)
+    if event == "ADDON_LOADED" then
+        HookPrimaryStatAdvancement()
+        return
+    end
+    if event == "PLAYER_LEAVING_WORLD" then
+        primaryStatWorldReady = false
+        primaryStatDungeon = nil
+        HidePrimaryStatReminder()
+        return
+    end
+    if event == "PLAYER_ENTERING_WORLD" then
+        primaryStatWorldReady = true
+        HookPrimaryStatAdvancement()
+    end
+    if not IsArea52PrimaryStatRealm() then return end
+    if event == "PLAYER_REGEN_DISABLED" then
+        HidePrimaryStatReminder()
+    elseif event == "PLAYER_REGEN_ENABLED" then
+        RequestPrimaryStatReminder(primaryStatDeferredClose)
+    elseif event == "QUEST_ACCEPTED" then
+        RequestPrimaryStatReminder(false)
+    elseif event == "PLAYER_ENTERING_WORLD" or event == "ZONE_CHANGED_NEW_AREA" then
+        local inside, kind = IsInInstance()
+        local name = GetInstanceInfo()
+        local dungeon = inside and (kind == "party" or kind == "raid") and name or nil
+        if dungeon and dungeon ~= primaryStatDungeon then RequestPrimaryStatReminder(false) end
+        primaryStatDungeon = dungeon
+    end
+end)

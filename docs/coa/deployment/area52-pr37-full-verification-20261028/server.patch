+    {
+        Unit* hunter = GetCaster();
+        if (hunter && AscensionFreePick::Applies(hunter->ToPlayer()))
+            if (AuraEffect const* effect = hunter->GetAuraEffect(Area52Marksman::HoneInDamage, EFFECT_0))
+                HoneInBonus = effect->GetAmount();
+    }

+            if (AuraEffect const* training = hunter->GetAuraEffect(Area52Marksman::SyndicateSniperTraining + rank,
+                EFFECT_0))
+            {
+                SetHitDamage(Area52Marksman::WithSniperTraining(GetHitDamage(), training->GetAmount()));
+                return;
+            }
+    }
+

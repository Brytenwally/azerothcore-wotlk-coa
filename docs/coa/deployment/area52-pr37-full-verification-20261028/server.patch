+            SPELL_AURA_ANY, AURA_EFFECT_HANDLE_REAL);
+        AfterEffectRemove += AuraEffectRemoveFn(aura_area52_archetype_cleanup::Clear, EFFECT_0,
+            SPELL_AURA_ANY, AURA_EFFECT_HANDLE_REAL);

+            EFFECT_1, SPELL_AURA_ADD_PCT_MODIFIER);
+        DoEffectCalcSpellMod += AuraEffectCalcSpellModFn(aura_area52_spirit_frost::Modifier,
+            EFFECT_2, SPELL_AURA_ADD_PCT_MODIFIER);

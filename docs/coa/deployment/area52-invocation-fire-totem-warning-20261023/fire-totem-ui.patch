+local function AddArea52FireTotemCost(tooltip, entry)
+    if GetRealmName() ~= "Area 52 - Free-Pick" or not C_Player or not C_Player:IsHero()
+        or not entry or (BuildCreatorUtil and BuildCreatorUtil.IsPickingSpells()) then return end
+    local mastery = entry.ID == 1316
+    local member = entry.ID == 2833 or entry.ID == 2903 or entry.ID == 2905
+        or entry.ID == 2906 or entry.ID == 3475
+    if not mastery and not member then return end
+    tooltip:AddLine(" ")
+    tooltip:AddLine("Fire Totem Mastery purchase costs", 1, 0.82, 0, true)
+    if mastery then
+        tooltip:AddLine("Mastery: 1 Ability Essence + 2 blue gems.", 1, 1, 1, true)
+        tooltip:AddLine("Each member totem: 1 Ability Essence; no additional gems.", 1, 1, 1, true)
+    else
+        tooltip:AddLine("This totem: 1 Ability Essence; no additional gems with Fire Totem Mastery.", 1, 1, 1, true)
+        tooltip:AddLine("Its standalone gem price above is not an additional Mastery cost.", 1, 1, 1, true)
+        if not C_CharacterAdvancement.IsKnownID(1316) then
+            tooltip:AddLine("Mastery + first totem: 2 Ability Essence + 2 blue gems total.", 1, 1, 1, true)
+        end
+    end
+end
+

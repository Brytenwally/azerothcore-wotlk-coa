+local Area52OrgrimmarRuneforgePOI = {}
+function Area52OrgrimmarRuneforgePOI:PLAYER_ENTERING_WORLD()
+    local realm = string.lower(GetRealmName() or "")
+    DB_MapPOI.RemovePOIByID("area52-orgrimmar-runeforge")
+    if string.find(realm, "area 52", 1, true) or string.find(realm, "area-52", 1, true) then
+        DB_MapPOI.CreatePOI("area52-orgrimmar-runeforge", "Runeforge",
+            "Orgrimmar Runeforge", 1898.15, -4139.91, 41.1577,
+            Enum.POIType.Townsfolk,
+            EnumUtil.CombineMasks(Enum.POIFlags.ShowOnMinimap, Enum.POIFlags.HasTooltip),
+            188, 1.5, nil, 1)
+    end
+end
+C_Hook:Register(Area52OrgrimmarRuneforgePOI, "PLAYER_ENTERING_WORLD")

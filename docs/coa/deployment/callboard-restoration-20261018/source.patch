+    WorldPacket update(SMSG_CALLBOARD_TOKEN_UPDATE, sizeof(CallboardPointsToken) + 2 * sizeof(uint32));
+    update << CallboardPointsToken << DisplayedProgress(points) << uint32(0);
+    player->SendDirectMessage(&update);

+    }
+
+    void Register() override
+    {
+        DoCheckProc += AuraCheckProcFn(aura_area52_bulwark_energy::Check);
+        OnEffectProc += AuraEffectProcFn(aura_area52_bulwark_energy::Proc, EFFECT_0, SPELL_AURA_DUMMY);
+    }
+};

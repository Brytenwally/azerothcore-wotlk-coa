+
+    void Damage(SpellEffIndex index)
+    {
+        if (GetSpellInfo()->GetCategory() == 1209)
+            return;
+        uint8 const level = GetCaster()->GetLevel();
+        float const limit = GetCaster()->HasAura(2565) ? 2.0f : 1.0f;
